# Create a bot at https://discord.com/developers/applications and paste its token here.
DISCORD_TOKEN=replace_me
BRIDGE_SECRET=replace_with_a_long_random_secret

# Optional initial channel. You can set/change it later with /setchat.
DISCORD_CHANNEL_ID=

# Mount a Railway volume at /data so /setchat survives redeployments.
CONFIG_PATH=/data/config.json

# Railway provides PORT automatically. This is useful only when running locally.
PORT=3000
